        "# Import required libraries\n",
        "import cv2\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "from google.colab import files\n",
        "\n",
        "# -------------------------------\n",
        "# Step 1: Upload the watch image\n",
        "# -------------------------------\n",
        "print(\"Upload the image containing the watch:\")\n",
        "uploaded = files.upload()\n",
        "\n",
        "# Get uploaded file name\n",
        "image_filename = list(uploaded.keys())[0]\n",
        "\n",
        "# Read the input image\n",
        "image = cv2.imread(image_filename)\n",
        "\n",
        "if image is None:\n",
        "    print(\"Error: Could not read the input image.\")\n",
        "else:\n",
        "    # Convert BGR to RGB for displaying\n",
        "    image_rgb = cv2.cvtColor(image, cv2.COLOR_BGR2RGB)\n",
        "\n",
        "    # Display the input image\n",
        "    plt.figure(figsize=(7, 5))\n",
        "    plt.imshow(image_rgb)\n",
        "    plt.title(\"Input Image\")\n",
        "    plt.axis(\"off\")\n",
        "    plt.show()\n",
        "\n",
        "    # --------------------------------\n",
        "    # Step 2: Upload the watch template\n",
        "    # --------------------------------\n",
        "    print(\"Now upload a template image containing a watch:\")\n",
        "    uploaded_template = files.upload()\n",
        "\n",
        "    template_filename = list(uploaded_template.keys())[0]\n",
        "\n",
        "    # Read template image\n",
        "    template = cv2.imread(template_filename)\n",
        "\n",
        "    if template is None:\n",
        "        print(\"Error: Could not read the template image.\")\n",
        "    else:\n",
        "        # Convert both images to grayscale\n",
        "        gray_image = cv2.cvtColor(image, cv2.COLOR_BGR2GRAY)\n",
        "        gray_template = cv2.cvtColor(template, cv2.COLOR_BGR2GRAY)\n",
        "\n",
        "        # Get template dimensions\n",
        "        template_height, template_width = gray_template.shape\n",
        "\n",
        "        # Perform template matching\n",
        "        result = cv2.matchTemplate(\n",
        "            gray_image,\n",
        "            gray_template,\n",
        "            cv2.TM_CCOEFF_NORMED\n",
        "        )\n",
        "\n",
        "        # Find the best matching location\n",
        "        min_val, max_val, min_loc, max_loc = cv2.minMaxLoc(result)\n",
        "\n",
        "        # Set matching threshold\n",
        "        threshold = 0.60\n",
        "\n",
        "        if max_val >= threshold:\n",
        "\n",
        "            # Top-left corner of detected object\n",
        "            top_left = max_loc\n",
        "\n",
        "            # Bottom-right corner\n",
        "            bottom_right = (\n",
        "                top_left[0] + template_width,\n",
        "                top_left[1] + template_height\n",
        "            )\n",
        "\n",
        "            # Draw rectangle around detected watch\n",
        "            output = image.copy()\n",
        "\n",
        "            cv2.rectangle(\n",
        "                output,\n",
        "                top_left,\n",
        "                bottom_right,\n",
        "                (0, 255, 0),\n",
        "                3\n",
        "            )\n",
        "\n",
        "            # Add label\n",
        "            cv2.putText(\n",
        "                output,\n",
        "                \"Watch Detected\",\n",
        "                (top_left[0], top_left[1] - 10),\n",
        "                cv2.FONT_HERSHEY_SIMPLEX,\n",
        "                0.8,\n",
        "                (0, 255, 0),\n",
        "                2\n",
        "            )\n",
        "\n",
        "            # Display result\n",
        "            output_rgb = cv2.cvtColor(\n",
        "                output,\n",
        "                cv2.COLOR_BGR2RGB\n",
        "            )\n",
        "\n",
        "            plt.figure(figsize=(8, 6))\n",
        "            plt.imshow(output_rgb)\n",
        "            plt.title(\n",
        "                f\"Watch Recognized \"\n",
        "                f\"(Confidence: {max_val:.2f})\"\n",
        "            )\n",
        "            plt.axis(\"off\")\n",
        "            plt.show()\n",
        "\n",
        "            # Save output\n",
        "            cv2.imwrite(\n",
        "                \"watch_detection_output.jpg\",\n",
        "                output\n",
        "            )\n",
        "\n",
        "            print(\"Watch recognized successfully!\")\n",
        "            print(f\"Matching confidence: {max_val:.2f}\")\n",
        "\n",
        "        else:\n",
        "            print(\"Watch not recognized.\")\n",
        "            print(f\"Matching confidence: {max_val:.2f}\")"
      ]
