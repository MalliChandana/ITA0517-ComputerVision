        "import cv2\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "from google.colab import files\n",
        "\n",
        "# Upload original image and watermark image\n",
        "print(\"Upload the ORIGINAL image:\")\n",
        "uploaded_original = files.upload()\n",
        "original_filename = next(iter(uploaded_original))\n",
        "\n",
        "print(\"Upload the WATERMARK image:\")\n",
        "uploaded_watermark = files.upload()\n",
        "watermark_filename = next(iter(uploaded_watermark))\n",
        "\n",
        "# Read both images\n",
        "original = cv2.imread(original_filename)\n",
        "watermark = cv2.imread(watermark_filename)\n",
        "\n",
        "# Check whether images are loaded\n",
        "if original is None or watermark is None:\n",
        "    print(\"Error: Could not load one or both images.\")\n",
        "else:\n",
        "    print(\"Both images loaded successfully!\")\n",
        "\n",
        "    # Get original image dimensions\n",
        "    h, w = original.shape[:2]\n",
        "\n",
        "    # Resize watermark to 25% of original image size\n",
        "    watermark_width = w // 4\n",
        "    watermark_height = h // 4\n",
        "\n",
        "    watermark = cv2.resize(\n",
        "        watermark,\n",
        "        (watermark_width, watermark_height)\n",
        "    )\n",
        "\n",
        "    # Position the watermark at bottom-right corner\n",
        "    x = w - watermark_width - 20\n",
        "    y = h - watermark_height - 20\n",
        "\n",
        "    # Create a region of interest\n",
        "    roi = original[y:y + watermark_height,\n",
        "                   x:x + watermark_width]\n",
        "\n",
        "    # Blend original region and watermark\n",
        "    blended = cv2.addWeighted(\n",
        "        roi, 0.7,\n",
        "        watermark, 0.3,\n",
        "        0\n",
        "    )\n",
        "\n",
        "    # Insert blended watermark into original image\n",
        "    watermarked_image = original.copy()\n",
        "    watermarked_image[\n",
        "        y:y + watermark_height,\n",
        "        x:x + watermark_width\n",
        "    ] = blended\n",
        "\n",
        "    # Convert BGR to RGB for displaying\n",
        "    original_rgb = cv2.cvtColor(original, cv2.COLOR_BGR2RGB)\n",
        "    watermark_rgb = cv2.cvtColor(watermark, cv2.COLOR_BGR2RGB)\n",
        "    result_rgb = cv2.cvtColor(\n",
        "        watermarked_image,\n",
        "        cv2.COLOR_BGR2RGB\n",
        "    )\n",
        "\n",
        "    # Display results\n",
        "    plt.figure(figsize=(15, 5))\n",
        "\n",
        "    plt.subplot(1, 3, 1)\n",
        "    plt.imshow(original_rgb)\n",
        "    plt.title(\"Original Image\")\n",
        "    plt.axis(\"off\")\n",
        "\n",
        "    plt.subplot(1, 3, 2)\n",
        "    plt.imshow(watermark_rgb)\n",
        "    plt.title(\"Watermark\")\n",
        "    plt.axis(\"off\")\n",
        "\n",
        "    plt.subplot(1, 3, 3)\n",
        "    plt.imshow(result_rgb)\n",
        "    plt.title(\"Watermarked Image\")\n",
        "    plt.axis(\"off\")\n",
        "\n",
        "    plt.tight_layout()\n",
        "    plt.show()"
