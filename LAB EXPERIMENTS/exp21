        "# Install OpenCV (if not already installed)\n",
        "!pip install opencv-python-headless matplotlib\n",
        "\n",
        "import cv2\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "from google.colab import files\n",
        "import io\n",
        "from PIL import Image\n",
        "\n",
        "# Upload image\n",
        "print(\"Upload an image:\")\n",
        "uploaded = files.upload()\n",
        "\n",
        "# Process image\n",
        "for filename in uploaded.keys():\n",
        "    # Load and convert to grayscale\n",
        "    img = np.array(Image.open(io.BytesIO(uploaded[filename])))\n",
        "    gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY) if len(img.shape)==3 else img\n",
        "\n",
        "    # Apply morphological opening\n",
        "    kernel = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (5,5))\n",
        "    opened = cv2.morphologyEx(gray, cv2.MORPH_OPEN, kernel)\n",
        "\n",
        "    # Display results\n",
        "    plt.figure(figsize=(15,5))\n",
        "    for i, (title, image) in enumerate([('Original', img),\n",
        "                                        ('Grayscale', gray),\n",
        "                                        ('Opening Result', opened)]):\n",
        "        plt.subplot(1,3,i+1)\n",
        "        plt.imshow(image, cmap='gray' if i>0 else None)\n",
        "        plt.title(title)\n",
        "        plt.axis('off')\n",
        "    plt.tight_layout()\n",
        "    plt.show()\n",
        "\n",
        "    print(f\"✓ Opening applied to: {filename}\")\n",
        "    print(f\"  Kernel: 5x5 ellipse | Iterations: 1\")"
      ]
