        "import cv2\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# Function to create a white image and draw a rectangle\n",
        "def create_rectangle_image(height, width):\n",
        "\n",
        "    # Create a white image\n",
        "    image = np.ones((height, width, 3), dtype=np.uint8) * 255\n",
        "\n",
        "    # Define rectangle coordinates\n",
        "    start_point = (50, 50)\n",
        "    end_point = (width - 50, height - 50)\n",
        "\n",
        "    # Draw rectangle\n",
        "    # (0, 0, 0) = Black color\n",
        "    # 3 = Thickness\n",
        "    cv2.rectangle(image, start_point, end_point, (0, 0, 0), 3)\n",
        "\n",
        "    return image\n",
        "\n",
        "\n",
        "# Get image size from user\n",
        "height = int(input(\"Enter image height: \"))\n",
        "width = int(input(\"Enter image width: \"))\n",
        "\n",
        "# Create image with rectangle\n",
        "image = create_rectangle_image(height, width)\n",
        "\n",
        "# Convert BGR to RGB for displaying with Matplotlib\n",
        "image_rgb = cv2.cvtColor(image, cv2.COLOR_BGR2RGB)\n",
        "\n",
        "# Display the image\n",
        "plt.figure(figsize=(8, 6))\n",
        "plt.imshow(image_rgb)\n",
        "plt.title(\"Rectangle using OpenCV\")\n",
        "plt.axis(\"off\")\n",
        "plt.show()"
      ]
