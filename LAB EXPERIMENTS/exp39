        "import cv2\n",
        "import os\n",
        "from google.colab import files\n",
        "from IPython.display import HTML\n",
        "from base64 import b64encode\n",
        "\n",
        "# Step 1: Upload the video\n",
        "uploaded = files.upload()\n",
        "\n",
        "# Get uploaded video filename\n",
        "input_video = list(uploaded.keys())[0]\n",
        "\n",
        "# Step 2: Open the video\n",
        "cap = cv2.VideoCapture(input_video)\n",
        "\n",
        "# Check if video opened successfully\n",
        "if not cap.isOpened():\n",
        "    print(\"Error: Could not open video!\")\n",
        "else:\n",
        "    print(\"Video loaded successfully:\", input_video)\n",
        "\n",
        "    # Step 3: Read all frames\n",
        "    frames = []\n",
        "\n",
        "    while True:\n",
        "        ret, frame = cap.read()\n",
        "\n",
        "        if not ret:\n",
        "            break\n",
        "\n",
        "        frames.append(frame)\n",
        "\n",
        "    cap.release()\n",
        "\n",
        "    print(\"Total frames:\", len(frames))\n",
        "\n",
        "    # Step 4: Reverse the frames\n",
        "    frames.reverse()\n",
        "\n",
        "    # Step 5: Get video properties\n",
        "    cap = cv2.VideoCapture(input_video)\n",
        "    fps = cap.get(cv2.CAP_PROP_FPS)\n",
        "    width = int(cap.get(cv2.CAP_PROP_FRAME_WIDTH))\n",
        "    height = int(cap.get(cv2.CAP_PROP_FRAME_HEIGHT))\n",
        "    cap.release()\n",
        "\n",
        "    # Step 6: Create output video\n",
        "    output_video = \"reverse_slow_motion.mp4\"\n",
        "\n",
        "    # Reduce FPS to create slow motion\n",
        "    slow_fps = fps / 2\n",
        "\n",
        "    fourcc = cv2.VideoWriter_fourcc(*\"mp4v\")\n",
        "    out = cv2.VideoWriter(\n",
        "        output_video,\n",
        "        fourcc,\n",
        "        slow_fps,\n",
        "        (width, height)\n",
        "    )\n",
        "\n",
        "    # Step 7: Write reversed frames\n",
        "    for frame in frames:\n",
        "        out.write(frame)\n",
        "\n",
        "    out.release()\n",
        "\n",
        "    print(\"Reverse slow-motion video created successfully!\")\n",
        "\n",
        "    # Step 8: Display the video in Google Colab\n",
        "    video_data = open(output_video, \"rb\").read()\n",
        "    video_base64 = b64encode(video_data).decode()\n",
        "\n",
        "    display(HTML(f\"\"\"\n",
        "    <video width=\"640\" controls>\n",
        "        <source src=\"data:video/mp4;base64,{video_base64}\" type=\"video/mp4\">\n",
        "    </video>\n",
        "    \"\"\"))"
