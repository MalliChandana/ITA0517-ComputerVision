        "# Import required libraries\n",
        "import cv2\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "from google.colab import files\n",
        "\n",
        "# Upload the input image\n",
        "uploaded = files.upload()\n",
        "\n",
        "# Get the uploaded file name\n",
        "filename = list(uploaded.keys())[0]\n",
        "\n",
        "# Read the image\n",
        "image = cv2.imread(filename)\n",
        "\n",
        "# Check if image is loaded successfully\n",
        "if image is None:\n",
        "    print(\"Error: Could not read the image.\")\n",
        "else:\n",
        "    # Convert BGR to RGB for displaying\n",
        "    image_rgb = cv2.cvtColor(image, cv2.COLOR_BGR2RGB)\n",
        "\n",
        "    # Convert image to grayscale\n",
        "    gray = cv2.cvtColor(image, cv2.COLOR_BGR2GRAY)\n",
        "\n",
        "    # Create a structuring element\n",
        "    kernel = np.ones((5, 5), np.uint8)\n",
        "\n",
        "    # Apply Black Hat morphological operation\n",
        "    # Black Hat = Closing - Original Image\n",
        "    black_hat = cv2.morphologyEx(\n",
        "        gray,\n",
        "        cv2.MORPH_BLACKHAT,\n",
        "        kernel\n",
        "    )\n",
        "\n",
        "    # Display the results\n",
        "    plt.figure(figsize=(12, 4))\n",
        "\n",
        "    # Original image\n",
        "    plt.subplot(1, 3, 1)\n",
        "    plt.imshow(image_rgb)\n",
        "    plt.title(\"Original Image\")\n",
        "    plt.axis(\"off\")\n",
        "\n",
        "    # Grayscale image\n",
        "    plt.subplot(1, 3, 2)\n",
        "    plt.imshow(gray, cmap=\"gray\")\n",
        "    plt.title(\"Grayscale Image\")\n",
        "    plt.axis(\"off\")\n",
        "\n",
        "    # Black Hat result\n",
        "    plt.subplot(1, 3, 3)\n",
        "    plt.imshow(black_hat, cmap=\"gray\")\n",
        "    plt.title(\"Black Hat Result\")\n",
        "    plt.axis(\"off\")\n",
        "\n",
        "    plt.show()\n",
        "\n",
        "    # Save the output image\n",
        "    cv2.imwrite(\"black_hat_output.jpg\", black_hat)\n",
        "\n",
        "    print(\"Black Hat operation completed successfully!\")\n",
        "    print(\"Output saved as: black_hat_output.jpg\")"
      ],
