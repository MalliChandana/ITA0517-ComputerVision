        "# Import required libraries\n",
        "import cv2\n",
        "from google.colab import files\n",
        "\n",
        "# ---------------------------------------\n",
        "# Step 1: Upload the input video\n",
        "# ---------------------------------------\n",
        "print(\"Upload a vehicle video:\")\n",
        "uploaded = files.upload()\n",
        "\n",
        "input_video = list(uploaded.keys())[0]\n",
        "\n",
        "# ---------------------------------------\n",
        "# Step 2: Load vehicle detection model\n",
        "# ---------------------------------------\n",
        "vehicle_cascade = cv2.CascadeClassifier(\n",
        "    cv2.data.haarcascades +\n",
        "    \"haarcascade_car.xml\"\n",
        ")\n",
        "\n",
        "# Check if cascade was loaded\n",
        "if vehicle_cascade.empty():\n",
        "    print(\"Error: Vehicle cascade could not be loaded.\")\n",
        "else:\n",
        "\n",
        "    # ---------------------------------------\n",
        "    # Step 3: Open the input video\n",
        "    # ---------------------------------------\n",
        "    cap = cv2.VideoCapture(input_video)\n",
        "\n",
        "    if not cap.isOpened():\n",
        "        print(\"Error: Could not open video.\")\n",
        "\n",
        "    else:\n",
        "        # Get video properties\n",
        "        fps = cap.get(cv2.CAP_PROP_FPS)\n",
        "        width = int(cap.get(cv2.CAP_PROP_FRAME_WIDTH))\n",
        "        height = int(cap.get(cv2.CAP_PROP_FRAME_HEIGHT))\n",
        "\n",
        "        # ---------------------------------------\n",
        "        # Step 4: Create output video\n",
        "        # ---------------------------------------\n",
        "        output_video = \"vehicle_detection_output.mp4\"\n",
        "\n",
        "        fourcc = cv2.VideoWriter_fourcc(*\"mp4v\")\n",
        "\n",
        "        out = cv2.VideoWriter(\n",
        "            output_video,\n",
        "            fourcc,\n",
        "            fps,\n",
        "            (width, height)\n",
        "        )\n",
        "\n",
        "        frame_number = 0\n",
        "\n",
        "        # ---------------------------------------\n",
        "        # Step 5: Process every frame\n",
        "        # ---------------------------------------\n",
        "        while True:\n",
        "\n",
        "            ret, frame = cap.read()\n",
        "\n",
        "            # Stop when video ends\n",
        "            if not ret:\n",
        "                break\n",
        "\n",
        "            frame_number += 1\n",
        "\n",
        "            # Convert frame to grayscale\n",
        "            gray = cv2.cvtColor(\n",
        "                frame,\n",
        "                cv2.COLOR_BGR2GRAY\n",
        "            )\n",
        "\n",
        "            # ---------------------------------------\n",
        "            # Detect vehicles\n",
        "            # ---------------------------------------\n",
        "            vehicles = vehicle_cascade.detectMultiScale(\n",
        "                gray,\n",
        "                scaleFactor=1.1,\n",
        "                minNeighbors=3,\n",
        "                minSize=(40, 40)\n",
        "            )\n",
        "\n",
        "            # ---------------------------------------\n",
        "            # Draw bounding boxes\n",
        "            # ---------------------------------------\n",
        "            for (x, y, w, h) in vehicles:\n",
        "\n",
        "                cv2.rectangle(\n",
        "                    frame,\n",
        "                    (x, y),\n",
        "                    (x + w, y + h),\n",
        "                    (0, 255, 0),\n",
        "                    2\n",
        "                )\n",
        "\n",
        "                cv2.putText(\n",
        "                    frame,\n",
        "                    \"Vehicle\",\n",
        "                    (x, y - 10),\n",
        "                    cv2.FONT_HERSHEY_SIMPLEX,\n",
        "                    0.7,\n",
        "                    (0, 255, 0),\n",
        "                    2\n",
        "                )\n",
        "\n",
        "            # Display number of vehicles\n",
        "            cv2.putText(\n",
        "                frame,\n",
        "                \"Vehicles: \" + str(len(vehicles)),\n",
        "                (20, 40),\n",
        "                cv2.FONT_HERSHEY_SIMPLEX,\n",
        "                1,\n",
        "                (0, 0, 255),\n",
        "                2\n",
        "            )\n",
        "\n",
        "            # Write processed frame\n",
        "            out.write(frame)\n",
        "\n",
        "        # Release resources\n",
        "        cap.release()\n",
        "        out.release()\n",
        "\n",
        "        print(\"Vehicle detection completed successfully!\")\n",
        "        print(\"Total frames processed:\", frame_number)\n",
        "        print(\"Output video:\", output_video)"
      ]
    }
