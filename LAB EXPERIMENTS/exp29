        "# Import required libraries\n",
        "import cv2\n",
        "import matplotlib.pyplot as plt\n",
        "from google.colab import files\n",
        "\n",
        "# ---------------------------------------\n",
        "# Step 1: Upload the input image\n",
        "# ---------------------------------------\n",
        "print(\"Upload an image containing human eyes:\")\n",
        "uploaded = files.upload()\n",
        "\n",
        "# Get the uploaded file name\n",
        "filename = list(uploaded.keys())[0]\n",
        "\n",
        "# ---------------------------------------\n",
        "# Step 2: Read the image\n",
        "# ---------------------------------------\n",
        "image = cv2.imread(filename)\n",
        "\n",
        "if image is None:\n",
        "    print(\"Error: Could not read the image.\")\n",
        "\n",
        "else:\n",
        "    # Convert BGR to RGB for displaying\n",
        "    image_rgb = cv2.cvtColor(image, cv2.COLOR_BGR2RGB)\n",
        "\n",
        "    # ---------------------------------------\n",
        "    # Step 3: Convert image to grayscale\n",
        "    # ---------------------------------------\n",
        "    gray = cv2.cvtColor(image, cv2.COLOR_BGR2GRAY)\n",
        "\n",
        "    # ---------------------------------------\n",
        "    # Step 4: Load Haar Cascade classifiers\n",
        "    # ---------------------------------------\n",
        "    face_cascade = cv2.CascadeClassifier(\n",
        "        cv2.data.haarcascades +\n",
        "        \"haarcascade_frontalface_default.xml\"\n",
        "    )\n",
        "\n",
        "    eye_cascade = cv2.CascadeClassifier(\n",
        "        cv2.data.haarcascades +\n",
        "        \"haarcascade_eye.xml\"\n",
        "    )\n",
        "\n",
        "    # ---------------------------------------\n",
        "    # Step 5: Detect faces\n",
        "    # ---------------------------------------\n",
        "    faces = face_cascade.detectMultiScale(\n",
        "        gray,\n",
        "        scaleFactor=1.1,\n",
        "        minNeighbors=5,\n",
        "        minSize=(50, 50)\n",
        "    )\n",
        "\n",
        "    total_eyes = 0\n",
        "\n",
        "    # ---------------------------------------\n",
        "    # Step 6: Detect eyes inside each face\n",
        "    # ---------------------------------------\n",
        "    for (x, y, w, h) in faces:\n",
        "\n",
        "        # Draw rectangle around face\n",
        "        cv2.rectangle(\n",
        "            image,\n",
        "            (x, y),\n",
        "            (x + w, y + h),\n",
        "            (255, 0, 0),\n",
        "            2\n",
        "        )\n",
        "\n",
        "        # Region of interest containing the face\n",
        "        face_gray = gray[y:y+h, x:x+w]\n",
        "        face_color = image[y:y+h, x:x+w]\n",
        "\n",
        "        # Detect eyes\n",
        "        eyes = eye_cascade.detectMultiScale(\n",
        "            face_gray,\n",
        "            scaleFactor=1.1,\n",
        "            minNeighbors=5,\n",
        "            minSize=(20, 20)\n",
        "        )\n",
        "\n",
        "        # ---------------------------------------\n",
        "        # Step 7: Draw rectangles around eyes\n",
        "        # ---------------------------------------\n",
        "        for (ex, ey, ew, eh) in eyes:\n",
        "\n",
        "            cv2.rectangle(\n",
        "                face_color,\n",
        "                (ex, ey),\n",
        "                (ex + ew, ey + eh),\n",
        "                (0, 255, 0),\n",
        "                2\n",
        "            )\n",
        "\n",
        "            cv2.putText(\n",
        "                face_color,\n",
        "                \"Eye\",\n",
        "                (ex, ey - 5),\n",
        "                cv2.FONT_HERSHEY_SIMPLEX,\n",
        "                0.5,\n",
        "                (0, 255, 0),\n",
        "                1\n",
        "            )\n",
        "\n",
        "            total_eyes += 1\n",
        "\n",
        "    # ---------------------------------------\n",
        "    # Step 8: Display the result\n",
        "    # ---------------------------------------\n",
        "    result = cv2.cvtColor(\n",
        "        image,\n",
        "        cv2.COLOR_BGR2RGB\n",
        "    )\n",
        "\n",
        "    plt.figure(figsize=(10, 7))\n",
        "    plt.imshow(result)\n",
        "    plt.title(\"Eye Detection Result\")\n",
        "    plt.axis(\"off\")\n",
        "    plt.show()\n",
        "\n",
        "    # ---------------------------------------\n",
        "    # Step 9: Display detection information\n",
        "    # ---------------------------------------\n",
        "    print(\"Number of faces detected:\", len(faces))\n",
        "    print(\"Number of eyes detected:\", total_eyes)\n",
        "\n",
        "    # ---------------------------------------\n",
        "    # Step 10: Save the output image\n",
        "    # ---------------------------------------\n",
        "    cv2.imwrite(\n",
        "        \"eye_detection_output.jpg\",\n",
        "        image\n",
        "    )\n",
        "\n",
        "    print(\"Eye detection completed successfully!\")\n",
        "    print(\"Output saved as: eye_detection_output.jpg\")"
      ]
