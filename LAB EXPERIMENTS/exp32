        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# Function to create the image\n",
        "def create_image(height, width):\n",
        "\n",
        "    # Create a white image\n",
        "    # 3 represents RGB color channels\n",
        "    image = np.ones((height, width, 3), dtype=np.uint8) * 255\n",
        "\n",
        "    # Box size = 1/10th of image dimensions\n",
        "    box_height = height // 10\n",
        "    box_width = width // 10\n",
        "\n",
        "    # Black box - Top Left\n",
        "    image[0:box_height, 0:box_width] = [0, 0, 0]\n",
        "\n",
        "    # Blue box - Top Right\n",
        "    image[0:box_height, width-box_width:width] = [0, 0, 255]\n",
        "\n",
        "    # Green box - Bottom Left\n",
        "    image[height-box_height:height, 0:box_width] = [0, 255, 0]\n",
        "\n",
        "    # Red box - Bottom Right\n",
        "    image[height-box_height:height, width-box_width:width] = [255, 0, 0]\n",
        "\n",
        "    return image\n",
        "\n",
        "\n",
        "# Get image size from user\n",
        "height = int(input(\"Enter image height: \"))\n",
        "width = int(input(\"Enter image width: \"))\n",
        "\n",
        "# Create the image\n",
        "image = create_image(height, width)\n",
        "\n",
        "# Display the image\n",
        "plt.figure(figsize=(8, 8))\n",
        "plt.imshow(image)\n",
        "plt.title(\"White Image with Four Colored Boxes\")\n",
        "plt.axis(\"off\")\n",
        "plt.show()"
      ]
