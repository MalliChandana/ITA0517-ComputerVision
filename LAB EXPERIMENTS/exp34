        "import cv2\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# Function to create a white image and draw a circle\n",
        "def create_circle_image(height, width):\n",
        "\n",
        "    # Create a white image\n",
        "    image = np.ones((height, width, 3), dtype=np.uint8) * 255\n",
        "\n",
        "    # Calculate center of the image\n",
        "    center = (width // 2, height // 2)\n",
        "\n",
        "    # Calculate radius\n",
        "    radius = min(height, width) // 4\n",
        "\n",
        "    # Draw circle\n",
        "    # (0, 0, 0) = Black color\n",
        "    # 3 = Thickness\n",
        "    cv2.circle(image, center, radius, (0, 0, 0), 3)\n",
        "\n",
        "    return image\n",
        "\n",
        "\n",
        "# Get image size from user\n",
        "height = int(input(\"Enter image height: \"))\n",
        "width = int(input(\"Enter image width: \"))\n",
        "\n",
        "# Create image with circle\n",
        "image = create_circle_image(height, width)\n",
        "\n",
        "# Convert BGR to RGB for Matplotlib\n",
        "image_rgb = cv2.cvtColor(image, cv2.COLOR_BGR2RGB)\n",
        "\n",
        "# Display the image\n",
        "plt.figure(figsize=(8, 6))\n",
        "plt.imshow(image_rgb)\n",
        "plt.title(\"Circle using OpenCV\")\n",
        "plt.axis(\"off\")\n",
        "plt.show()"
      ]
